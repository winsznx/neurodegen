# ============================================================
# NeuroDegen V2 — Environment Variables
# Source of truth: NEURODEGEN_V2_PRD.md §12
# ============================================================

# ---- CoinMarketCap Hub ----
# MCP transport (free Basic tier sufficient; 10k credits/mo covers V2 cadence)
CMC_PRO_API_KEY=

# x402 transport wallet (Base USDC; agent pays 0.01 USDC/call for premium CMC tools when EV gate passes)
CMC_X402_WALLET_PRIVATE_KEY=
CMC_X402_WALLET_ADDRESS=

# ---- Trust Wallet Agent Kit (TWAK) ----
# Install: npm install -g @trustwallet/cli
# Agent's BSC wallet — managed by TWAK keychain at runtime
TWAK_AGENT_WALLET_ADDRESS=
TWAK_AGENT_PRIVATE_KEY=
TWAK_WALLET_PASSWORD=
TWAK_API_KEY=

# ---- LLM (BYOK primary, DGrid fallback) ----
# Narrative analyst: Claude Sonnet 4.6 direct → DGrid claude-sonnet-4.6 → DGrid claude-haiku-4.5
ANTHROPIC_API_KEY=
# Quant analyst: GPT-4o direct → DGrid openai/gpt-4o → DGrid openai/gpt-4o-mini
OPENAI_API_KEY=
# Risk classifier: deepseek/deepseek-v3.2 via DGrid (no direct API needed)
DGRID_API_KEY=

# ---- Database (Supabase) ----
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# ---- Chain RPCs ----
BSC_RPC_URL=
BSC_RPC_URL_FALLBACK=
PYTH_HERMES_URL=https://hermes.pyth.network

# ---- On-chain contracts ----
# AttestationEmitter — V1 verified to have commitReasoning + revealExecution selectors. Do NOT redeploy.
ATTESTATION_CONTRACT_ADDRESS=0xe21f5ebec3f098c744c1e35db0c9338d6b717dc4
# Competition registration contract (BSC mainnet). Reissued per competition cycle.
COMPETITION_CONTRACT_ADDRESS=0x212c61b9b72c95d95bf29cf032f5e5635629aed5

# ---- Competition timing (UTC) ----
COMPETITION_REGISTRATION_DEADLINE=2026-06-22T00:00:00Z
COMPETITION_TRADING_WINDOW_START=2026-06-22T00:00:00Z
COMPETITION_TRADING_WINDOW_END=2026-06-28T23:59:59Z

# ---- Risk sizing (mandate overrides at runtime; these are agent-wide defaults) ----
AGENT_BASE_POSITION_SIZE_USD=100
MIN_POSITION_SIZE_USD=5
PER_POSITION_SIZE_CAP_USD=200
MAX_CONCURRENT_POSITIONS=5
MAX_TOTAL_EXPOSURE_RATIO=0.8
MAX_DAILY_LOSS_USD=50

# Drawdown ladder (15% alert / 20% defensive / 25% halt / 30% disqualification)
DRAWDOWN_ALERT_PCT=0.15
DRAWDOWN_DEFENSIVE_PCT=0.20
DRAWDOWN_HALT_PCT=0.25

# Compliance probe trade
PROBE_TRADE_USD=10
PROBE_TRADE_HOUR_UTC=18
PROBE_TRADE_FROM_SYMBOL=BUSD
PROBE_TRADE_TO_SYMBOL=CAKE

# ---- Pre-execution check thresholds ----
ORACLE_DIVERGENCE_MAX_PCT=0.005
MAX_SLIPPAGE_PCT=0.005
SECURITY_RISK_SCORE_MAX=60
GAS_BUFFER_BNB=0.005

# ---- Perception cadence ----
CMC_QUOTES_POLL_INTERVAL_MS=60000
CMC_GLOBAL_POLL_INTERVAL_MS=300000
CMC_NARRATIVES_POLL_INTERVAL_MS=300000
CMC_NEWS_POLL_INTERVAL_MS=600000
CMC_DERIVATIVES_POLL_INTERVAL_MS=300000
REGIME_REEVAL_INTERVAL_MS=60000
HOT_STATE_TTL_MINUTES=30
EVENT_BATCH_SIZE=100

# ---- EV gate ----
EV_THRESHOLD=3.0
EV_BASE_CONFIDENCE=0.5
X402_COST_PER_CALL_USDC=0.01

# ---- Cognition ----
MIN_CONFIDENCE_TO_ACT=0.3
MAX_OUTPUT_TOKENS=2048
LLM_CACHE_TTL_MS=120000

# ---- Inbound x402 (user pays agent for session API) ----
X402_REVENUE_ADDRESS=
X402_INBOUND_PRICE_USDT_ATOMIC=10000
X402_INBOUND_PRICE_USDT_HUMAN=0.01

# ---- Feature flags (V2.0.0) ----
# Master kill. Hard off by default. Flip true on Railway worker for live trading.
ENABLE_EXECUTION=false
# On-chain attestation emission. On by default.
ENABLE_ATTESTATION=true
# Inbound x402 gating on /api/x402/* routes.
ENABLE_X402_INBOUND=true
# Outbound x402 transport (gated by EV gate per call).
ENABLE_X402_OUTBOUND=true
# DGrid is the primary reasoning gateway. BYOK direct API keys (if set) are
# tried as a FALLBACK after DGrid. Flip PREFER_BYOK_ROUTING=true to invert.
ENABLE_BYOK_ROUTING=true
PREFER_BYOK_ROUTING=false
DISABLE_DGRID_ROUTING=false
# Daily probe trade for competition compliance.
ENABLE_PROBE_TRADE=true
# V2.1 deferrals
ENABLE_PERP_MODE=false
ENABLE_TELEGRAM_ALERTS=false
ENABLE_NLP_MANDATE_PARSER=false
# Dry-run mode. Default true. Flip false (with ENABLE_EXECUTION=true) for real swaps.
DRY_RUN_MODE=true

# ---- App URL ----
NEXT_PUBLIC_APP_URL=https://neurodegen.xyz

# ---- Admin / Worker coordination ----
ADMIN_SECRET=
# Worker-only: when "true", realtimeService forwards events to WEB_BROADCAST_URL.
WORKER_MODE=
WEB_BROADCAST_URL=
WORKER_ADMIN_URL=

# ---- Runtime ----
NODE_ENV=production
