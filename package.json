{
  "name": "neurodegen",
  "version": "0.1.0",
  "private": true,
  "license": "AGPL-3.0-only",
  "packageManager": "pnpm@10.33.0",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "worker": "tsx watch --env-file=.env.local src/worker/index.ts",
    "worker:start": "tsx src/worker/index.ts",
    "attestation:compile": "tsx scripts/compileAttestation.ts",
    "attestation:deploy": "tsx scripts/deployAttestation.ts",
    "attestation:ship": "pnpm attestation:compile && pnpm attestation:deploy",
    "attestation:v2:compile": "tsx scripts/compileAttestationV2.ts",
    "attestation:v2:deploy": "tsx scripts/deployAttestationV2.ts",
    "attestation:v2:verify": "tsx scripts/verifyAttestationV2.ts",
    "attestation:v2:ship": "pnpm attestation:v2:compile && pnpm attestation:v2:deploy",
    "logo:build": "tsx scripts/buildLogo.ts"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.103.0",
    "next": "16.2.3",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "viem": "^2.47.17",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@resvg/resvg-js": "^2.6.2",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.2.3",
    "solc": "0.8.28",
    "tailwindcss": "^4",
    "tsx": "4.19.2",
    "typescript": "^5",
    "vitest": "^4.1.4"
  }
}
